# Copy to .env.local. Local values come from `pnpm db:status`; cloud values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SECRET_KEY=

# Public site address, used in WhatsApp product links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
